+// ---------- OAuth access tokens and app sync ----------
+
+const ACCESS_TOKEN_TTL_SECONDS = 60 * 60 * 24 * 30;
+
+export function hashAccessToken(token: string): string {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+export async function createAccessToken(userId: string, clientId: string): Promise<{ token: string; expiresIn: number }> {
+  const token = newToken(48);
+  const now = Date.now();
+  const entry: OAuthAccessToken = {
+    userId,
+    clientId,
+    createdAt: new Date(now).toISOString(),
+    expiresAt: new Date(now + ACCESS_TOKEN_TTL_SECONDS * 1000).toISOString()
+  };
+  await kvPut(accessTokenKey(hashAccessToken(token)), entry, { expirationTtl: ACCESS_TOKEN_TTL_SECONDS });
+  return { token, expiresIn: ACCESS_TOKEN_TTL_SECONDS };
+}
+
+export async function getAccessToken(token: string): Promise<OAuthAccessToken | null> {
+  if (!token || token.length > 200) return null;
+  const entry = await kvGet<OAuthAccessToken>(accessTokenKey(hashAccessToken(token)));
+  if (!entry || new Date(entry.expiresAt) < new Date()) return null;
+  return entry;
+}
+
+export async function deleteAccessToken(token: string): Promise<void> {
+  await kvDelete(accessTokenKey(hashAccessToken(token)));
+}
+
+export async function getSyncBlob(userId: string): Promise<SyncBlob | null> {
+  return kvGet<SyncBlob>(syncKey(userId));
+}
+
+/** Writes the blob only if `baseRev` is still the stored revision (0 means "nothing stored yet"). */
+export async function putSyncBlob(
+  userId: string,
+  baseRev: number,
+  blob: string
+): Promise<{ ok: true; entry: SyncBlob } | { ok: false; current: SyncBlob | null }> {
+  const current = await getSyncBlob(userId);
+  if ((current?.rev ?? 0) !== baseRev) return { ok: false, current };
+  const entry: SyncBlob = { rev: baseRev + 1, blob, updatedAt: new Date().toISOString() };
+  await kvPut(syncKey(userId), entry);
+  return { ok: true, entry };
+}
+
+export async function deleteSyncBlob(userId: string): Promise<void> {
+  await kvDelete(syncKey(userId));
+}
