+import { NextRequest, NextResponse } from "next/server";
+import { getBearerUser } from "@/lib/bearer";
+
+export const dynamic = "force-dynamic";
+
+/** Who does this token belong to? Used by apps (such as Glyde) to show "signed in as ...". */
+export async function GET(req: NextRequest) {
+  const auth = await getBearerUser(req);
+  if (!auth) return NextResponse.json({ error: "Invalid or expired token." }, { status: 401 });
+  const { user, entry } = auth;
+  return NextResponse.json({
+    id: user.id,
+    email: user.email,
+    name: user.name,
+    client_id: entry.clientId,
+    expires_at: entry.expiresAt
+  });
+}
diff --git a/app/api/sync/settings/route.ts b/app/api/sync/settings/route.ts
new file mode 100644
index 0000000..bbf1616
--- /dev/null
+++ b/app/api/sync/settings/route.ts
@@ -0,0 +1,51 @@
+import { NextRequest, NextResponse } from "next/server";
+import { getBearerUser } from "@/lib/bearer";
+import { checkRateLimit } from "@/lib/rateLimit";
+import { deleteSyncBlob, getSyncBlob, putSyncBlob } from "@/lib/store";
+
+export const dynamic = "force-dynamic";
+
+const MAX_BLOB_CHARS = 200_000;
+
+/**
+ * App settings sync (used by Glyde). The app encrypts everything before it gets here, so this
+ * route only ever stores and returns an opaque string. Nothing here can read it.
+ *
+ *   GET    -> { rev, blob, updatedAt }   (404 if nothing has been saved yet)
+ *   PUT    -> body { baseRev, blob }     (409 with the current copy if baseRev is out of date)
+ *   DELETE -> removes the stored copy
+ */
+export async function GET(req: NextRequest) {
+  const auth = await getBearerUser(req);
+  if (!auth) return NextResponse.json({ error: "Unauthorized." }, { status: 401 });
+  const entry = await getSyncBlob(auth.user.id);
+  if (!entry) return NextResponse.json({ error: "Nothing saved yet." }, { status: 404 });
+  return NextResponse.json(entry);
+}
+
+export async function PUT(req: NextRequest) {
+  const auth = await getBearerUser(req);
+  if (!auth) return NextResponse.json({ error: "Unauthorized." }, { status: 401 });
+
+  const limit = await checkRateLimit("sync-write", auth.user.id, 120, 3600);
+  if (!limit.allowed) return NextResponse.json({ error: "Too many saves. Try again soon." }, { status: 429 });
+
+  const body = await req.json().catch(() => null);
+  const baseRev = Number.isInteger(body?.baseRev) && body.baseRev >= 0 ? (body.baseRev as number) : -1;
+  const blob = typeof body?.blob === "string" ? body.blob : "";
+  if (baseRev < 0) return NextResponse.json({ error: "baseRev must be a whole number, 0 or more." }, { status: 400 });
+  if (!blob || blob.length > MAX_BLOB_CHARS) {
+    return NextResponse.json({ error: `blob must be 1 to ${MAX_BLOB_CHARS} characters.` }, { status: 400 });
+  }
+
+  const result = await putSyncBlob(auth.user.id, baseRev, blob);
+  if (!result.ok) return NextResponse.json({ error: "Out of date.", current: result.current }, { status: 409 });
+  return NextResponse.json(result.entry);
+}
+
+export async function DELETE(req: NextRequest) {
+  const auth = await getBearerUser(req);
+  if (!auth) return NextResponse.json({ error: "Unauthorized." }, { status: 401 });
+  await deleteSyncBlob(auth.user.id);
+  return NextResponse.json({ ok: true });
+}
