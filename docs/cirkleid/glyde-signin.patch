diff --git a/lib/bearer.ts b/lib/bearer.ts
new file mode 100644
index 0000000..009818f
--- /dev/null
+++ b/lib/bearer.ts
@@ -0,0 +1,17 @@
+import { NextRequest } from "next/server";
+import { getAccessToken, getUserById } from "./store";
+import type { CirkleUser, OAuthAccessToken } from "./types";
+
+/** Reads "Authorization: Bearer <token>" and returns the token record plus the (active) user. */
+export async function getBearerUser(
+  req: NextRequest
+): Promise<{ token: string; entry: OAuthAccessToken; user: CirkleUser } | null> {
+  const header = req.headers.get("authorization") || "";
+  const match = /^Bearer ([A-Za-z0-9_-]{20,200})$/.exec(header);
+  if (!match) return null;
+  const entry = await getAccessToken(match[1]);
+  if (!entry) return null;
+  const user = await getUserById(entry.userId);
+  if (!user || user.status !== "active") return null;
+  return { token: match[1], entry, user };
+}
